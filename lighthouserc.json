{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "startServerCommand": "pnpm build && pnpm preview --host 127.0.0.1 --port 4174",
      "startServerReadyPattern": "4174",
      "startServerReadyTimeout": 30000,
      "url": ["http://127.0.0.1:4174/"]
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "aggregationMethod": "median", "minScore": 1 }],
        "categories:accessibility": ["error", { "aggregationMethod": "median", "minScore": 1 }],
        "categories:best-practices": ["error", { "aggregationMethod": "median", "minScore": 1 }],
        "categories:seo": ["error", { "aggregationMethod": "median", "minScore": 1 }],
        "categories:agentic-browsing": ["error", { "aggregationMethod": "median", "minScore": 1 }],
        "largest-contentful-paint": [
          "error",
          { "aggregationMethod": "median", "maxNumericValue": 2000 }
        ],
        "cumulative-layout-shift": [
          "error",
          { "aggregationMethod": "median", "maxNumericValue": 0.1 }
        ],
        "total-blocking-time": ["error", { "aggregationMethod": "median", "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
