{
  "name": "affordi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware --react-plugin --deny-warnings src tests scripts vite.config.ts playwright.config.ts commitlint.config.mjs release.config.mjs",
    "lint:fix": "pnpm lint --fix",
    "lint:actions": "actionlint",
    "doctor": "react-doctor --verbose --blocking warning --yes --scope full --no-score --no-supply-chain",
    "doctor:design": "react-doctor design --verbose --blocking warning --yes --scope full --no-score --no-supply-chain",
    "fallow:check": "fallow dead-code --fail-on-issues",
    "fallow:audit": "fallow audit --base main",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:e2e": "playwright test",
    "test:e2e:dist": "AFFORDI_USE_PREBUILT=true playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:pwa": "playwright test tests/e2e/offline.spec.ts --project=chromium",
    "lighthouse": "pnpm build && pnpm lighthouse:dist",
    "lighthouse:dist": "lhci autorun --config=lighthouserc.json",
    "precommit:check": "pnpm format:check && pnpm lint && pnpm lint:actions && pnpm typecheck && pnpm test",
    "prepush:check": "pnpm verify",
    "commitlint": "commitlint --last --verbose",
    "release": "semantic-release",
    "prepare": "node scripts/install-hooks.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm lint:actions && pnpm run doctor && pnpm run doctor:design && pnpm fallow:check && pnpm test:coverage && pnpm build && pnpm check:bundle && pnpm check:pwa",
    "ci": "pnpm verify && pnpm audit --audit-level moderate && pnpm test:e2e:dist && pnpm lighthouse:dist"
  },
  "dependencies": {
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fallow": "3.34.0",
    "jsdom": "30.1.3",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "react-doctor": "0.9.18",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5",
    "workbox-window": "7.4.1",
    "wrangler": "4.151.1"
  },
  "engines": {
    "node": "26.12.0"
  }
}
