{
  "name": "affordi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint --type-aware --react-plugin --deny-warnings src tests scripts vite.config.ts playwright.config.ts commitlint.config.mjs release.config.mjs",
    "lint:fix": "pnpm lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit --pretty false",
    "check:pwa": "node scripts/check-pwa.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "test:pwa": "playwright test tests/e2e/offline.spec.ts --project=chromium",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "precommit:check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "prepush:check": "pnpm run ci",
    "commitlint": "commitlint --last --verbose",
    "release": "semantic-release",
    "prepare": "node scripts/install-hooks.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:bundle && pnpm check:pwa",
    "ci": "pnpm verify && pnpm audit --audit-level moderate && pnpm test:e2e && pnpm lighthouse"
  },
  "dependencies": {
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.0",
    "jsdom": "30.0.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0",
    "workbox-window": "7.4.1"
  },
  "engines": {
    "node": "26.8.2"
  }
}
