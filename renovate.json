{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":enableVulnerabilityAlertsWithLabel(security)"],
  "timezone": "Europe/Belgrade",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "vulnerabilityAlerts": {
    "prConcurrentLimit": 5
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "automerge": false,
  "packageRules": [
    {
      "matchPackageNames": ["@playwright/test", "mcr.microsoft.com/playwright"],
      "groupName": "Playwright browser runtime",
      "minimumReleaseAge": "7 days"
    }
  ]
}
